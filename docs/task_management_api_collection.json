  "item": [
    {
      "name": "1. Authentication (OAuth2 & Devise)",
      "item": [
        {
          "name": "01 - Get OAuth Token (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('Saved access_token:', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "{{admin_email}}", "type": "text" },
                { "key": "password", "value": "{{admin_password}}", "type": "text" },
                { "key": "client_id", "value": "{{client_id}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth/token",
              "host": ["{{base_url}}"],
              "path": ["oauth", "token"]
            },
            "description": "Requests OAuth2 Bearer token via password flow linked to Devise user. Automatically captures token into collection variable."
          }
        },
        {
          "name": "02 - Get OAuth Token (Member Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('Saved Alice access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "{{alice_email}}", "type": "text" },
                { "key": "password", "value": "{{member_password}}", "type": "text" },
                { "key": "client_id", "value": "{{client_id}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth/token",
              "host": ["{{base_url}}"],
              "path": ["oauth", "token"]
            },
            "description": "Requests token for regular member user to test role-based access restrictions."
          }
        },
        {
          "name": "03 - Register New User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"email\": \"developer@railshub.dev\",\n    \"password\": \"Dev@123456\",\n    \"password_confirmation\": \"Dev@123456\",\n    \"full_name\": \"Senior Developer\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Public registration endpoint that creates a new member account."
          }
        },
        {
          "name": "04 - Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"email\": \"alice@railshub.dev\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/password",
              "host": ["{{base_url}}"],
              "path": ["users", "password"]
            },
            "description": "Devise API endpoint that sends password reset instructions."
          }
        },
        {
          "name": "05 - Revoke Token (Logout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "token", "value": "{{access_token}}", "type": "text" },
                { "key": "client_id", "value": "{{client_id}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth/revoke",
              "host": ["{{base_url}}"],
              "path": ["oauth", "revoke"]
            },
            "description": "Revokes current token, invalidating it immediately in the database."
          }
        }
      ]
    },
